{
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*)\\.(css|js|png|jpg|svg|ico|json)",
            "dest": "/public/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}
